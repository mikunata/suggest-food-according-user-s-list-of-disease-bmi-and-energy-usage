int finddate(FILE *dietaryinfo)
{
    printf("Input date (dd/mm/yyyy): ");
    scanf("%s", inputdate);
    rewind(dietaryinfo);
    char line[256], date[15];
    int found = 0;
    while (fgets(line, 256, dietaryinfo))
    {
        sscanf(line, "%*s %*s %*d %*d %*d %*d %s %*d", date);
        if (strcmp(date, inputdate) == 0)
        {
            found = 1;
            break;
        }
    }
    if (found == 0)
        printf("No match found. Please try again.\n");
    return found;
}
void drawgraph(FILE *dietaryinfo)
{
    system("cls");
    int day,month,year;
    sscanf(inputdate,"%d/%d/%d",&day,&month,&year);
    int i, j, bars[7] = {0};
    rewind(dietaryinfo);
    char line[256],date[15];
    int calories,meal_day,meal_month,meal_year;
    while(fgets(line,256,dietaryinfo))
    {
        if (sscanf(line,"%*s %*s %*d %*d %*d %*d %s %d",date,&calories)==2)
        {
            sscanf(date,"%d/%d/%d",&meal_day,&meal_month,&meal_year);
            if (meal_month==month&&meal_year==year)
            {
                int week_index=(meal_day-1)%7;
                bars[week_index]+=calories;
            }
        }
    }
    for(i=0; i<30; i++) printf(" ");
    printf("%s %d\n  kcal\n    |\n",monthname[month-1],year);
    for(i=30; i>0; i--)
    {
        if(i%5==0)
        {
            printf("%4d+    ",i*100);
            for(j=0; j<7; j++)
            {
                if(bars[j]>=i*100)
                {
                    BGgreen();
                    green();
                    printf("####");
                    BGreset();
                    black();
                    printf("####");
                    reset();
                }
                else printf("        ");
            }
            printf("\n");
        }
        else if(i%5!=0&&i!=1)
        {
            printf("    |    ");
            for(j=0; j<7; j++)
            {
                if(bars[j]>=i*100)
                {
                    BGgreen();
                    green();
                    printf("####");
                    BGreset();
                    black();
                    printf("####");;
                    reset();
                }
                else printf("        ");
            }
            printf("\n");
        }
        else
        {
            printf("    |    ");
            for(j=0; j<7; j++)
            {
                if(bars[j]>=i*100)
                {
                    BGgreen();
                    black();
                    printf("%4d",bars[j]);
                    BGreset();
                    black();
                    printf("####");
                    reset();
                }
                else printf("        ");
            }
            printf("\n");
        }
    }
    printf("   0-------------------------------------------------------------day\n     ");
    if(day<=7)
    {
        for(i=0; i<7; i++) printf("%8d",i+1);
    }
    if(day>7&&day<=14)
