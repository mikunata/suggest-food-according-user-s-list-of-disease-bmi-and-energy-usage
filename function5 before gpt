#include <stdio.h>
#include <stdlib.h>
#include <string.h>
void drawgraph();
int finddate();
char monthname[12][15]={"January","February","March","April","May","June","July","August","September","October","November","December"};
char inputdate[15];

main(){
    FILE *dietaryinfo;
    dietaryinfo=fopen("User_dietary_information1.txt","r");
    if(!dietaryinfo) {
        printf("Error opening file");
    }
    int found;
    found=finddate(dietaryinfo);
    if(found==1){drawgraph(dietaryinfo);}
    fclose(dietaryinfo);
}

int finddate(FILE *dietaryinfo){
    printf("Input date (dd/mm/yyyy): ");
    scanf("%s",inputdate);
    char line[15];
    int line_number=0,found=0;
    while(fgets(line,15,dietaryinfo)){
        line_number++;
        line[strcspn(line, "\n")] = '\0';
        if (strcmp(line,inputdate)==0) {
            found=1;
            break;
        }
    }
    if(found==0) printf("No match found. Please try again.\n");
    return found;
}
void drawgraph(FILE *dietaryinfo)
{
    int day,month,year;
    sscanf(inputdate,"%d/%d/%d",&day,&month,&year);
    int i, j, bars[7] = {0};
    for(i=0;i<30;i++) printf(" ");
    printf("%s %d\n  kcal\n    |\n",monthname[month-1],year);
    for(i=30;i>0;i--)
    {
        if(i%5==0){
        printf("%4d+    ",i*100);
        for(j=0;j<7;j++)
        {
            if(bars[j]>=i*100) printf("####    ");
            else printf("        ");
        }
        printf("\n");
        }
        else{
        printf("    |    ");
        for(j=0;j<7;j++)
        {
            if(bars[j]>=i*100) printf("####    ");
            else printf("        ");
        }
        printf("\n");
        }
    }
    printf("   0-------------------------------------------------------------day\n     ");
    if(day<=7){
        for(i=0;i<7;i++) printf("%8d",i+1);
    }
    if(day>7&&day<=14){
        for(i=0;i<7;i++) printf("%8d",i+8);
    }
    if(day>14&&day<=21){
        for(i=0;i<7;i++) printf("%8d",i+15);
    }
    if(day>21&&day<=28){
        for(i=0;i<7;i++) printf("%8d",i+22);
    }
    if(day>28){
        if(month==1||month==3||month==5||month==7||month==8||month==10||month==12) for(i=0;i<3;i++) printf("%8d",i+29);
        if(month==4||month==6||month==9||month==11) for(i=0;i<2;i++) printf("%8d",i+29);
        if(month==2&&(year%4)==0) printf("%8d",29);
    }
    //for(i=0; i<7; i++) printf("%8d", bars[i]);
    printf("\n         ");
    return 0;
}
